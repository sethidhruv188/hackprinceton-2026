# Copy to .env and fill in. Never commit .env.
# Agent model (agent/llm.py): OpenRouter through langchain-openai; LLM_MODEL must support tool calling
LLM_PROVIDER=openrouter
LLM_MODEL=
OPENROUTER_API_KEY=
# Optional: web search for the research sub-agents, and LangSmith tracing
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shakti-agent
# iMessage (Photon); allowlisted owner numbers, comma-separated, E.164
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_TEST_SENDER=
PHOTON_AGENT_HANDLE=
# Live Bedrock check (check_bedrock.py)
BEDROCK_MODEL_ID=
AWS_REGION=

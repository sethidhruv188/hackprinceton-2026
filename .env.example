# Copy to .env and fill in. Never commit .env.
# Agent model (agent/llm.py): OpenRouter through langchain-openai; LLM_MODEL must support tool calling
LLM_PROVIDER=openrouter
LLM_MODEL=
OPENROUTER_API_KEY=
# Optional: web search for the research sub-agents, and LangSmith tracing
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shakti-agent
# iMessage (Photon 2.0): python -m imessage.bot
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_HANDLE=
# owner numbers (role owner), comma-separated, E.164 like +15551234567; everyone else is a read-only guest
PHOTON_OWNER_NUMBERS=
PHOTON_ALLOW_GUESTS=true
# the agent's folders (data_demo / outputs_demo for the demo)
AGENT_DATA=data
AGENT_OUT=outputs
# older echo-bot setting, still read as an owner number
PHOTON_TEST_SENDER=
# Live Bedrock check (check_bedrock.py)
BEDROCK_MODEL_ID=
AWS_REGION=
